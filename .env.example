# Copy to .env (never commit .env).

# Supabase Postgres connection string.
# Dashboard → Connect → "Session pooler" (5432) or "Transaction pooler" (6543); both work
# over IPv4, while the direct connection is IPv6-only.
# Format: postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres
DATABASE_URL=

# Optional. The Chrome or Chromium that prints PDF documents; found in the
# usual places when unset (/usr/bin/google-chrome, /usr/bin/chromium…).
CHROME_PATH=

# Optional. Where the web app is reached, for the links to documents the MCP
# server returns; http://localhost:3000 when unset.
APP_URL=
