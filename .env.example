# Copy to .env (never commit .env).

# Supabase Postgres connection string.
# Dashboard → Connect → "Session pooler" (5432) or "Transaction pooler" (6543); both work
# over IPv4, while the direct connection is IPv6-only.
# Format: postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres
DATABASE_URL=
